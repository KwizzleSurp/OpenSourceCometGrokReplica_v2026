# ============================================================
# OpenSourceCometGrokReplica_v2026 — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Ollama ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Chroma Vector Store ---
CHROMA_PERSIST_DIR=./projects/profundus-comet/memory

# --- Web Search (choose one) ---
# Option A: Self-hosted SearxNG (recommended, zero leakage)
SEARXNG_URL=http://localhost:8080
# Option B: Tavily API (cloud)
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Active Project ---
ACTIVE_PROJECT=profundus-comet
PROJECT_CONFIG=./project_config.yaml

# --- Agent Settings ---
AGENT_MAX_ITERATIONS=20
AGENT_VERBOSE=true

# --- Optional: FastAPI server ---
API_HOST=0.0.0.0
API_PORT=8000
